# Postgres — self-hosted via infra/docker-compose.yml (the `postgres` service).
# Host is "postgres" (Docker's internal DNS) when apps run in-compose, or
# "localhost" when you run an app with `pnpm dev` on the bare server/laptop.
POSTGRES_DB=threers
POSTGRES_USER=threers
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://threers:changeme@postgres:5432/threers
# DATABASE_URL=postgresql://threers:changeme@localhost:5432/threers   # bare pnpm dev

# MinIO — self-hosted S3-compatible storage (the `minio` service).
# Host port 9000 was already taken by another project's MinIO on this
# server (puresmell-minio-1) — 3ers's compose maps host 9910 -> container
# 9000. MINIO_ENDPOINT below is the container-internal address (unaffected
# by the host port remap; only used for server-side Docker-network calls).
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=http://minio:9000       # internal — server-side calls only (HeadObject, DeleteObject)
# MINIO_PUBLIC_URL is what presigned upload/download URLs are SIGNED against
# (packages/db/src/storage.ts) — it must be a browser-reachable origin, or
# uploads/downloads will fail to resolve. The host nginx vhost
# infra/nginx/host/storage.celebrio-digital.conf proxies this domain straight
# through to 127.0.0.1:9910 (the minio service), path unmodified.
MINIO_PUBLIC_URL=https://storage.celebrio-digital.com
# MINIO_PUBLIC_URL=http://localhost:9910   # bare pnpm dev, no nginx in front

# Auth — separate secrets so JWTs are not cross-app valid
ADMIN_NEXTAUTH_SECRET=changeme_admin_32_chars_minimum_random
ADMIN_NEXTAUTH_URL=http://localhost:3901
PORTAL_NEXTAUTH_SECRET=changeme_portal_32_chars_minimum_random
PORTAL_NEXTAUTH_URL=http://localhost:3902

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend
RESEND_API_KEY=re_...
RESEND_FROM=no-reply@3ers.tn

# App URLs
INVITE_BASE_URL=http://localhost:3900
ADMIN_URL=http://localhost:3901
PORTAL_URL=http://localhost:3902
MARKETING_URL=http://localhost:3903

# Public URLs baked into the client bundle (admin, portal, marketing).
# NEXT_PUBLIC_INVITE_URL is the domain couples' invitations live on:
# an invitation is served at {NEXT_PUBLIC_INVITE_URL}/{slug} once its order is
# status=live with a valid configLive. The admin/portal show it as the share URL.
NEXT_PUBLIC_INVITE_URL=https://celebrio-digital.com
NEXT_PUBLIC_SITE_URL=https://celebrio-digital.com
# Slug routing is live: the invite app serves /{slug} from orders.config_live
# (order must be status=live). Portal share/preview URLs append the slug.
NEXT_PUBLIC_INVITE_SLUG_ROUTING=true

# Multi-zone (see platform/docs/09-domains.md): the marketing app owns the
# apex domain and proxies unmatched paths (couples' slugs, invite media) to
# the invite app's own origin. NEVER point this at the apex itself (loop).
# On the shared server, invite and marketing are containers on the SAME
# Docker host, so this goes straight over loopback rather than round-tripping
# through the public internet + nginx again — same value in dev and prod here.
INVITE_ORIGIN=http://127.0.0.1:3900

# Homepage reel / preview room target — a real LIVE order's URL.
# Defaults to {NEXT_PUBLIC_INVITE_URL}/fahmi-esmiralda (the seeded showcase).
# NEXT_PUBLIC_SHOWCASE_INVITE_URL=https://celebrio-digital.com/fahmi-esmiralda
