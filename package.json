{
  "name": "3ers",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @3ers/db drizzle-kit generate",
    "db:migrate": "pnpm --filter @3ers/db drizzle-kit migrate",
    "docker:up": "docker compose --project-directory . -f infra/docker-compose.yml up -d",
    "docker:dev": "docker compose --project-directory . -f infra/docker-compose.yml -f infra/docker-compose.dev.yml up",
    "docker:down": "docker compose --project-directory . -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "turbo": "2.3.3"
  }
}
